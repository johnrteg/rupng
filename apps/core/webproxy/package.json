{
    "name": "proxy",
    "version": "1.0.2",
    "private": true,
    "main": "./bin/index.js",
    "scripts": {
        "build": "rup-bundle && npm run copy:config",
        "copy:config": "node -e \"require('fs').cpSync('src/config','bin/config',{recursive:true})\"",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/http-proxy": "11.5.0",
        "@fastify/static": "9.1.3",
        "@repo/common": "*",
        "@repo/services": "*",
        "axios": "1.18.0",
        "ws": "8.21.0"
    },
    "devDependencies": {
        "@repo/build": "*",
        "@repo/tsconfig": "*",
        "@types/node": "26.0.0",
        "@types/ws": "8.18.1",
        "tsx": "4.22.4"
    }
}
