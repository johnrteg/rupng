{
    "name": "rupng",
    "private": true,
    "version": "1.0.0",
    "packageManager": "npm@11.16.0",
    "description": "",
    "workspaces": [
        "apps/*/*",
        "packages/*",
        "cloud"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "typecheck": "turbo run typecheck",
        "test": "vitest",
        "auth": "npm run dev -- --filter=auth",
        "auth.image": "docker build --build-arg APP_NAME=auth --build-arg APP_PATH=core/auth -t rupapp-auth .",
        "auth.docker": "docker run -p 3000:3000 rupapp-auth",
        "dispatch": "npm run dev -- --filter=dispatch",
        "dispatch.image": "docker build --build-arg APP_NAME=dispatch --build-arg APP_PATH=core/dispatch -t rupapp-dispatch .",
        "dispatch.docker": "docker run -p 3001:3000 rupapp-dispatch",
        "proxy": "npm run dev -- --filter=proxy",
        "proxy.local": "npm run dev -- --filter=proxy -- --config local",

        "web.build" : "npm run build -- --filter=web"
    },
    "devDependencies": {
        "@repo/tsconfig": "*",
        "turbo": "2.9.16",
        "typescript": "5.9.3",
        "vitest": "4.1.8"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johnrteg/rupng.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/johnrteg/rupng/issues"
    },
    "homepage": "https://github.com/johnrteg/rupng#readme"
}
