{
    "name": "rupng",
    "private": true,
    "version": "1.0.1",
    "packageManager": "npm@11.16.0",
    "description": "",
    "workspaces": [
        "apps/*/*",
        "packages/*",
        "cloud"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "typecheck": "turbo run typecheck",
        "test": "vitest",
        "auth": "npm run dev -- --filter=auth",
        "auth.image": "docker build --build-arg APP_NAME=auth --build-arg APP_PATH=core/auth -t rupapp-auth .",
        "auth.docker": "docker run -p 3000:3000 rupapp-auth",
        "dispatch": "npm run dev -- --filter=dispatch",
        "dispatch.image": "docker build --build-arg APP_NAME=dispatch --build-arg APP_PATH=core/dispatch -t rupapp-dispatch .",
        "dispatch.docker": "docker run -p 3001:3000 rupapp-dispatch",
        "proxy": "npm run dev -- --filter=proxy",
        "proxy.local": "npm run dev -- --filter=proxy -- --config local",
        "web": "npm run dev -- --filter=web",
        "web.watch": "npm --workspace web run build -- --watch",
        "web.build": "npm run build -- --filter=web"
    },
    "devDependencies": {
        "@repo/tsconfig": "*",
        "turbo": "2.9.18",
        "typescript": "6.0.3",
        "vitest": "4.1.9"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johnrteg/rupng.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/johnrteg/rupng/issues"
    },
    "homepage": "https://github.com/johnrteg/rupng#readme",
    "dependencies": {
        "@aws-sdk/client-apigatewaymanagementapi": "3.1073.0",
        "@aws-sdk/client-appconfig": "3.1073.0",
        "@aws-sdk/client-appconfigdata": "3.1073.0",
        "@aws-sdk/client-bedrock-runtime": "3.1073.0",
        "@aws-sdk/client-cognito-identity-provider": "3.1073.0",
        "@aws-sdk/client-dynamodb": "3.1073.0",
        "@aws-sdk/client-eventbridge": "3.1073.0",
        "@aws-sdk/client-kms": "3.1073.0",
        "@aws-sdk/client-lambda": "3.1073.0",
        "@aws-sdk/client-mediaconvert": "3.1073.0",
        "@aws-sdk/client-s3": "3.1073.0",
        "@aws-sdk/client-scheduler": "3.1073.0",
        "@aws-sdk/client-secrets-manager": "3.1073.0",
        "@aws-sdk/client-sesv2": "3.1073.0",
        "@aws-sdk/client-sns": "3.1073.0",
        "@aws-sdk/client-sqs": "3.1073.0",
        "@aws-sdk/credential-providers": "3.1073.0",
        "@aws-sdk/lib-dynamodb": "3.1073.0",
        "@aws-sdk/rds-signer": "3.1073.0",
        "@aws-sdk/s3-request-presigner": "3.1073.0",
        "@fastify/http-proxy": "11.5.0",
        "@mui/icons-material": "9.1.1",
        "@mui/material": "9.1.1",
        "@mui/x-date-pickers": "9.6.0",
        "@types/aws-lambda": "8.10.162",
        "@types/node": "26.0.0",
        "@types/react": "19.2.17",
        "aws-cdk": "2.1128.0",
        "aws-cdk-lib": "2.260.0",
        "axios": "1.18.0",
        "esbuild": "0.28.1",
        "pg": "8.22.0",
        "react-resizable": "4.0.2",
        "ws": "8.21.0"
    }
}
