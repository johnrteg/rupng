{
    "name": "cloud",
    "version": "1.0.3",
    "private": true,
    "scripts": {
        "build": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "synth": "cdk synth",
        "diff": "cdk diff",
        "deploy": "cdk deploy",
        "synth:dev": "cdk synth -c env=dev",
        "synth:staging": "cdk synth -c env=staging",
        "synth:prod": "cdk synth -c env=production",
        "diff:dev": "cdk diff --all -c env=dev",
        "diff:staging": "cdk diff --all -c env=staging",
        "diff:prod": "cdk diff --all -c env=production",
        "bootstrap:dev": "cdk bootstrap -c env=dev",
        "bootstrap:staging": "cdk bootstrap -c env=staging",
        "bootstrap:prod": "cdk bootstrap -c env=production",
        "deploy:dev": "cdk deploy --all -c env=dev --require-approval never",
        "deploy:staging": "cdk deploy --all -c env=staging --require-approval never",
        "deploy:prod": "cdk deploy --all -c env=production",
        "local:up": "docker compose -f local/docker-compose.yml up -d",
        "local:down": "docker compose -f local/docker-compose.yml down -v",
        "local:bootstrap": "cdklocal bootstrap -c env=local",
        "local:synth": "cdklocal synth -c env=local",
        "local:deploy": "cdklocal deploy -c env=local --all --require-approval never",
        "local:destroy": "cdklocal destroy -c env=local --all --force"
    },
    "dependencies": {
        "@repo/api": "*",
        "@repo/cloud-manifest": "*",
        "@repo/endpoint": "*",
        "app": "*",
        "auth": "*",
        "web": "*",
        "aws-cdk-lib": "2.260.0",
        "constructs": "10.6.0"
    },
    "devDependencies": {
        "@repo/tsconfig": "*",
        "@types/node": "26.0.0",
        "aws-cdk": "2.1128.0",
        "aws-cdk-local": "3.0.4",
        "tsx": "4.22.4"
    }
}
