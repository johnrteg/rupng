# build output
**/bin
**/dist

# turbo cache
.turbo
**/.turbo

# cdk synth output — lives INSIDE the build context (cloud/cdk.out), so CDK's Docker-asset staging
# would copy it into itself recursively → ENAMETOOLONG. Must be excluded from the build context.
cdk.out
**/cdk.out

# claude code workspace (not part of any image)
.claude
**/.logs

# environment files
.env
.env.*
**/.env
**/.env.*

# git
.git
.gitignore

# docker
docker-compose.yml
**/Dockerfile

# IDE
.vscode
.idea

# logs
*.log
**/logs

# OS
.DS_Store
Thumbs.db

